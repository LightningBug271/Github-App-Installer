<!DOCTYPE html>
<html>
<head>
    <title>Github App Installer (JScript)</title>
    
    <HTA:APPLICATION 
        ID="GithubAppInstaller(JScript)"
        APPLICATIONNAME="GithubAppInstaller(JScript)"
        SCROLL="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
    />
    <script language="VBScript">
        Function JsgBox(prompt, buttons, title)
            JsgBox = MsgBox(prompt, buttons, title)
        End Function
    </script>
	<script language="JScript">
	window.onload = function() {
			window.resizeTo(550, 700);
		};
	        function Git() {
             var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
                  if (response == 6) {
                    var shell = new ActiveXObject("WScript.Shell");
                    var command = "winget install git.git --scope user";
                    var exitCode = shell.Run(command, 1, true);
                    if (exitCode !== 0) {
                        JsgBox("Install failed for Git. Exit code: " + exitCode, 0, "GithubAppInstaller");
                    } else {
                        JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                    }
                  }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                  }
                
                
        }
	        function VSCode() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install Microsoft.VisualStudioCode --scope user";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for VS Code. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function PWSH() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install Microsoft.Powershell --source winget";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for PowerShell. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function UniGet() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install Devolutions.UniGetUI --scope user";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for UniGetUI. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function Copilot() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install GitHub.Copilot";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for GitHub Copilot. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function LFS() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install GitHub.LFS";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for Git LFS. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function Hub() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install GitHub.GitHubDesktop";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for GitHub Desktop. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function npm() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install OpenJS.NodeJS.LTS --scope user";
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for Node.js. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
	        function Elec() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install -e --id OpenJS.Electron.44"
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for Electron. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
            function Note() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "winget install notepad++ --scope user"
                var exitCode = shell.Run(command, 1, true);
                if (exitCode !== 0) {
                    JsgBox("Install failed for Notepad++. Exit code: " + exitCode, 0, "GithubAppInstaller");
                } else {
                    JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
            }
			function closeAPP() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                			window.close();
              }else {
                    JsgBox("Canceled.", 0 , "GithubAppInstaller");
                }
		}
            function Video() {
            var shell = new ActiveXObject("WScript.Shell");
            var command  ="https://www.youtube.com/watch?v=dQw4w9WgXcQ&list=RDdQw4w9WgXcQ&start_radio=1"
            shell.Run(command, 1, true);
            }
    /* Now time to convert this into the raw code files!
    Thats going to be fun! - @LightningBug271, 26.11.1*/
        Function tsc() {
            var response = JsgBox("Are you Sure?", 4+32 ,"GithubAppInstaller");
              if (response == 6) {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "cmd /c npm install -g typescript";
                shell.Run(command, 1, true);
                JsgBox("TypeScript installed globally. You can run tsc from the command line.", 0 , "GithubAppInstaller");
                JsgBox("Installation Complete.", 0 , "GithubAppInstaller");
                }else {
                    JsgBox("Installation Canceled.", 0 , "GithubAppInstaller");
                }
        }
    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #61ab75;
            padding: 20px;
        }
        .btn {
            display: block;
            width: 260px;
            padding: 10px;
            margin: 10px 0;
            cursor: pointer;
        }
    </style>
</head>
<body>
	<center><h1>GithubAppInstaller</h1></center>
    <center><h2>JScript Edition</h2></center>
    <h2>Select a App:</h2>
    <h6>In order to make a man or a boy covet a thing, it is only necessary to make the thing difficult to attain. <i>Twain, Mark. The Adventures of Tom Sawyer. pg 20.</i></h6>
    <input type="button" class="btn" value="Download Git" onClick="Git()">
    <input type="button" class="btn" value="Download Github" onClick="Hub()">
    <input type="button" class="btn" value="Download VSCode" onClick="VSCode()">
    <input type="button" class="btn" value="Download Powershell" onClick="PWSH()">
    <input type="button" class="btn" value="Download UniGetUI" onClick="UniGet()">
    <input type="button" class="btn" value="Download Github Copilot" onClick="Copilot()">
    <input type="button" class="btn" value="Download Git LFS" onClick="LFS()">
    <input type="button" class="btn" value="Download Node.js" onClick="npm()">
	<input type="button" class="btn" value="Download Electron" onClick="Elec()">
	<input type="button" class="btn" value="Download Notepad++" onClick="Note()">
    <input type="button" class="btn" value="Download TypeScript" onClick="tsc()">
    <hr>
<h3>Important Video</h3>
<input type="button" class="btn" value="Open Video" onClick="Video()">
    <hr>    
    <input type="button" class="btn" value="Exit Application" onClick="closeAPP()">
<h6>GithubAppInstaller version: 2.1.0: prerelease FRICK</h6>

</body>
</html>