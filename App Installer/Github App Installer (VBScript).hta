<!DOCTYPE html>
<html>
<head>
    <title>Github App Installer Basic</title>
    
    <HTA:APPLICATION 
        ID="GithubAppInstallerBasic"
        APPLICATIONNAME="GithubAppInstallerBasic"
        SCROLL="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
    />

    <script language="VBScript">
        Sub Window_OnLoad
            window.resizeTo 550, 700
        End Sub
        Sub Git
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install git.git --scope user"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
    End Select
        End Sub
        Sub VSCode
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install Microsoft.VisualStudioCode --scope user"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
    End Select
	End Sub
        Sub PWSH
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install --id Microsoft.PowerShell --source winget"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
    End Select
	End Sub	
        Sub UniGet
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install Devolutions.UniGetUI --scope user"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub
        Sub Copilot
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
        Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install GitHub.Copilot"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub	
        Sub LFS
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install GitHub.GitLFS"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub
        Sub Hub
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install -e --id GitHub.GitHubDesktop"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub	
        Sub npm
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "winget install OpenJS.NodeJS.LTS --scope user"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub	
		Sub Elec
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
			set objShell = CreateObject("WScript.Shell")
			objShell.Run "winget install -e --id OpenJS.Electron.44"
            MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
	End Select
    End Sub
 Sub sysint
         response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
        Select Case response
            Case vbYes
                CreateObject("WScript.Shell")
			    objShell.Run "winget install -e --id Microsoft.Sysinternals.ProcessExplorer --scope user"
                MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
            Case vbNo
                MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
        End Select
End Sub
Sub Note
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
    Select Case response
        Case vbYes
                CreateObject("WScript.Shell")
			    objShell.Run "winget install notepad++ --scope user"
                MsgBox "Installation Complete.", 0 , "GithubAppInstaller"
        Case vbNo
            MsgBox "Installation Canceled.", 0 , "GithubAppInstaller"
    End Select
End Sub
        Sub CloseApp
        response = MsgBox ("Are you Sure?", 4+32 ,"GithubAppInstaller")
        Select Case response
        Case vbYes
            window.close()
        Case vbNo
        MsgBox "Cancelled.", 0 , "GithubAppInstaller"
        End Select
        End Sub
    Sub VeryImportant
        Set objShell = CreateObject("WScript.Shell")
        objShell.Run "https://www.youtube.com/watch?v=dQw4w9WgXcQ&list=RDdQw4w9WgXcQ&start_radio=1"
    End Sub
    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #61ab75;
            padding: 20px;
        }
        .btn {
            display: block;
            width: 260px;
            padding: 10px;
            margin: 10px 0;
            cursor: pointer;
        }
    </style>
</head>
<body>
	<center><h1>GithubAppInstaller</h1></center>
    <center><h2>Basic Edition</h2></center>
    <h2>Select a App:</h2>
    <h6>In order to make a man or a boy covet a thing, it is only necessary to make the thing difficult to attain. <i>Twain, Mark. The Adventures of Tom Sawyer. pg 20.</i></h6>
    <input type="button" class="btn" value="Download Git" onClick="Git">
    <input type="button" class="btn" value="Download Github" onClick="Hub">
    <input type="button" class="btn" value="Download VSCode" onClick="VSCode">
    <input type="button" class="btn" value="Download Powershell" onClick="PWSH">
    <input type="button" class="btn" value="Download UniGetUI" onClick="UniGet">
    <input type="button" class="btn" value="Download Github Copilot" onClick="Copilot">
    <input type="button" class="btn" value="Download Git LFS" onClick="LFS">
    <input type="button" class="btn" value="Download Node.js" onClick="npm">
	<input type="button" class="btn" value="Download Electron" onClick="Elec">
    <input type="button" class="btn" value="Download Process Explorer" onClick="sysint">
    <input type="button" class="btn" value="Download Notepad++" onClick="Note">
    


    <hr>
<h3>Video On how to use</h3>
<input type="button" class="btn" value="Open Youtube Video" onClick="VeryImportant">
    <hr>    
    <input type="button" class="btn" value="Exit Application" onClick="CloseApp">
<h6>GithubAppInstaller version: 2.0.0</h6>

</body>
</html>
